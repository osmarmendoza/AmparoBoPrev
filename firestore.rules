rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Specific Validation ---

    function isValidGirl(data) {
      return data.keys().hasAll(['nombre', 'codigoRiesgo']) &&
             data.nombre is string && data.nombre.size() > 0 &&
             data.codigoRiesgo in ['rojo', 'amarillo'];
    }

    function isValidVisit(data) {
      return data.keys().hasAll(['girlId', 'fecha', 'staffIds']) &&
             data.girlId is string &&
             data.fecha is string &&
             data.staffIds is list;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['fecha', 'turno', 'asistencias']) &&
             data.fecha is string &&
             data.turno in ['mañana', 'tarde'] &&
             data.asistencias is list;
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll(['fecha', 'tipo', 'titulo']) &&
             data.fecha is string &&
             data.tipo in ['feriado', 'inconveniente', 'actividad', 'taller'] &&
             data.titulo is string;
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['nombre', 'email', 'rolId']) &&
             data.nombre is string &&
             data.email is string &&
             data.rolId is string;
    }

    function isValidRole(data) {
      return data.keys().hasAll(['nombre', 'permissionKeys']) &&
             data.nombre is string &&
             data.permissionKeys is list;
    }

    // --- Rules for Collections ---

    match /girls/{girlId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidGirl(incoming());
      allow delete: if isSignedIn(); // Or restrict to admin
    }

    match /visits/{visitId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidVisit(incoming());
      allow delete: if isSignedIn();
    }

    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidAttendance(incoming());
    }

    match /calendar/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidCalendarEvent(incoming());
      allow delete: if isSignedIn();
    }

    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidStaff(incoming());
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidRole(incoming());
    }
  }
}
